[Unit]
Description=CRM Backend (Gunicorn)
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/crm/backend
EnvironmentFile=/var/www/crm/backend/.env
ExecStart=/var/www/crm/backend/env/bin/gunicorn crm_backend.wsgi:application --bind 127.0.0.1:8000 --workers 3 --timeout 120
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
